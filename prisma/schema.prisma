generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  polls     Poll[]
}

model Poll {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  url         String     @unique
  createdAt   DateTime   @default(now())
  userId      Int
  imageUrl    String?
  user        User       @relation(fields: [userId], references: [id])
  questions   Question[]
  tokens      Token[]
}

model Question {
  id          Int        @id @default(autoincrement())
  text        String
  answerType  String     @default("default")
  imageUrl    String?
  isOptional  Boolean    @default(false)
  pollId      Int
  category    String?
  description String?
  likelihood  Int?
  consequences Int?
  options     Option[]
  poll        Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses   Response[]
}

model Option {
  id         Int        @id @default(autoincrement())
  text       String
  questionId Int
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responses  Response[]
}

model Token {
  id        String     @id @default(cuid())
  token     String     @unique
  pollId    Int
  used      Boolean    @default(false)
  maxVotes  Int        @default(1)
  voteCount Int        @default(0)
  createdAt DateTime   @default(now())
  responses Response[]
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

model Response {
  id         Int      @id @default(autoincrement())
  token      String
  questionId Int
  optionId   Int?
  text       String?
  createdAt  DateTime @default(now())
  option     Option?  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tokenRel   Token    @relation(fields: [token], references: [id], onDelete: Cascade)
}
